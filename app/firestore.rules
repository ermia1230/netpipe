rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User directory: anyone signed in can look users up by email,
    // but you can only write your own entry.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats: only participants can read or change them.
    match /chats/{chatId} {
      // Reading a chat that doesn't exist (yet) reveals nothing, so it is allowed;
      // otherwise a listener started right after creating a chat can fail.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      function isChatParticipant() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      // Messages: new ones must be NetPipe records (ciphertext), never plaintext.
      match /messages/{messageId} {
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.netpipe is map
          && !('text' in request.resource.data);
      }

      // NetPipe handshake transcripts and stream offsets (see utils/secureSession.js).
      match /netpipe/{sessionId} {
        allow read, create, update: if isChatParticipant();
      }
    }

    // Calls: only the caller and callee can see or change a call.
    match /calls/{callId} {
      function isParty(call) {
        return request.auth != null
          && (request.auth.uid == call.callerId || request.auth.uid == call.calleeId);
      }
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow read, update: if isParty(resource.data);

      // WebRTC connection details (ICE candidates) exchanged during setup.
      match /{side}/{candidateId} {
        allow read, create: if (side == 'callerCandidates' || side == 'calleeCandidates')
          && isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
      }
    }
  }
}
